# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Public site URL, used for SEO metadata, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.bookykitabevi.com

# Prisma SQLite database file (dev). Point to a Postgres connection string in production.
DATABASE_URL="file:./dev.db"

# Auth.js (next-auth v5) session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Only needed for non-standard proxy/self-hosted deployments; usually inferred automatically.
AUTH_URL=

# When "true", every visitor is redirected to /{locale}/coming-soon. Set to "false"
# (or remove) to make the site fully public again. Requires a rebuild/redeploy to take effect.
NEXT_PUBLIC_COMING_SOON_MODE=false

# Secret used to bypass the coming-soon redirect during development/preview.
# Visit any page with ?preview=<this value> once; a 30-day cookie remembers the bypass after that.
# Generate with: openssl rand -hex 16 — keep it private, do not share or commit the real value.
COMING_SOON_BYPASS_SECRET=

# Vercel Blob storage token, used by the admin CMS image upload endpoint
# (app/api/admin/upload). Create a Blob store under the Vercel project's
# Storage tab, then copy its Read/Write token here.
BLOB_READ_WRITE_TOKEN=

# SMTP credentials used by the contact form (app/api/contact) to email
# submissions out. For Google Workspace: host smtp.gmail.com, port 587,
# user is the full mailbox address, password is an App Password (requires
# 2-Step Verification) generated at myaccount.google.com/apppasswords —
# never the account's normal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Mailbox that receives contact form submissions. Defaults to SMTP_USER if
# not set.
CONTACT_FORM_TO=

# Google reCAPTCHA v2 (checkbox) keys for the contact form's spam-bot
# protection (components/forms/ContactForm.tsx, lib/recaptcha.ts). Register
# the site's domain(s) at https://www.google.com/recaptcha/admin — the site
# key is public (safe to expose in the browser), the secret key must stay
# server-only. Leave both empty to disable: the widget won't render and the
# contact form will fail closed (submissions rejected) until configured.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
